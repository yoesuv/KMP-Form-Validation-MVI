root = true

[*.{kt,kts}]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 140
trim_trailing_whitespace = true

# KMP / Compose friendly naming:
# Allow UpperCamelCase for @Composable functions (App, LoginScreen, AppButton, previews, ...)
ktlint_function_naming_ignore_when_annotated_with = Composable

# Generated code (Compose Resources, build intermediates, ...) lives under build/.
# ktlint has no native "exclude paths" option; the documented way to skip a directory
# is `ktlint = disabled` in a path section (see KtLint FAQ: "How do I disable ktlint
# for generated code?" https://pinterest.github.io/ktlint/1.2.1/faq/).
# Note: `**/build/**` (leading ** + single dir) is a supported glob form.
[**/build/**]
ktlint = disabled
